#!/bin/bash
set -euo pipefail
if ! declare -F autocycle_git >/dev/null; then autocycle_git() { command git "$@"; }; fi

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "Not inside a Git repository."
    exit 1
}

cd "$ROOT"

if [[ -z "$(git status --porcelain)" ]]; then
    echo "Nothing to checkpoint."
    exit 0
fi

BRANCH=$(git branch --show-current)

if [[ -z "$BRANCH" ]]; then
    echo "Detached HEAD. Refusing."
    exit 1
fi

autocycle_git fetch --prune origin >/dev/null

# Never commit implementation work directly to main or a planning branch.
# If we are not already on a checkpoint branch, create one.
if [[ "$BRANCH" != checkpoint/* ]]; then
    BRANCH="checkpoint/$(date +%Y%m%d-%H%M%S)"

    while git show-ref --verify --quiet "refs/heads/$BRANCH" \
       || git show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; do
        sleep 1
        BRANCH="checkpoint/$(date +%Y%m%d-%H%M%S)"
    done

    git switch -c "$BRANCH" >/dev/null
fi

# Custom message:
#   checkpoint "my message"
#
# Default message:
#   derive "Step 2.14" from IMPLEMENTATION.md
if [[ $# -gt 0 ]]; then
    MESSAGE="$*"
else
    MESSAGE=""

    if [[ -f IMPLEMENTATION.md ]]; then
        MESSAGE=$(
            sed -nE 's/^# (Step [^ ]+).*/\1/p' IMPLEMENTATION.md \
            | head -n 1
        )
    fi

    if [[ -z "$MESSAGE" ]]; then
        MESSAGE="Checkpoint $(date '+%Y-%m-%d %H:%M')"
    fi
fi

# AutoCycle supplies a frozen provider result and a clean ownership baseline.
# Recheck immediately around staging; on failure preserve both work and index.
owned_checkpoint_guard() {
    if [[ "${AUTOCYCLE_CHECKPOINT_GUARD:-0}" == 1 ]]; then
        python3 "$HOME/.autocycle/adjudication.py" checkpoint-safe || {
            echo "Checkpoint ownership/evidence changed; work and index preserved."
            return 1
        }
    fi
}
owned_checkpoint_guard
git add -A
owned_checkpoint_guard

if ! OUTPUT=$(git commit -m "$MESSAGE" 2>&1); then
    echo "$OUTPUT"
    exit 1
fi

# Reconcile owner-authored remote planning edits only after an owned local
# checkpoint exists. Preserve both parent histories and require following Review.
if [[ "${AUTOCYCLE_CHECKPOINT_GUARD:-0}" == 1 ]]; then
    python3 "$HOME/.autocycle/remote_docs.py" merge || exit 1
fi

CHECKPOINT_SHA=$(git rev-parse HEAD)
if OUTPUT=$(autocycle_git push origin "$CHECKPOINT_SHA:refs/heads/$BRANCH" 2>&1); then :; else
    RC=$?
    echo "$OUTPUT"
    exit "$RC"
fi

[[ "$(git rev-parse HEAD)" == "$CHECKPOINT_SHA" && "$(git branch --show-current)" == "$BRANCH" ]] || {
    echo "Checkpoint changed during publication; preserve for ownership reconciliation."
    exit 1
}
git branch --set-upstream-to="origin/$BRANCH" "$BRANCH" >/dev/null

echo "Branch: $BRANCH"
echo "Commit: $(git log -1 --oneline)"
