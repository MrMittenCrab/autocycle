    fi

    if grep -q '^PLAN_STATUS:' "$ANSWER"; then
        [[ "$(grep -c '^PLAN_STATUS:' "$ANSWER")" == 1 ]] && grep -qx 'PLAN_STATUS: BLOCKED' "$ANSWER" \
            || fail "malformed planning status."
        [[ "$(grep -c '^BLOCKER: .\+' "$ANSWER" || true)" == 1 ]] || fail "planning blocker lacks reason."
        ! grep -Eq '^(BEGIN_IMPLEMENTATION_MD|END_IMPLEMENTATION_MD)$' "$ANSWER" || fail "mixed planning blocker and implementation block."
        local ROUTE_RC=0 ROUTE_RESULT
        ROUTE_RESULT=$(progress plan-unavailable "$ANSWER" "$CACHE_FILE") || ROUTE_RC=$?
        if [[ "$ROUTE_RC" == 78 ]]; then
            live_finish "✗" "$ROUTE_RESULT"
            exit 78
        fi
        [[ "$ROUTE_RC" == 3 ]] || fail "invalid planning inability report."
        adjudication candidate planning "$ANSWER" "${AUTOCYCLE_INPUT_BATCH:-}" || fail "cannot preserve planning blocker."
        live_finish "↪" "Blocker candidate → Review"
        exit 42
    fi

    # Parse only the final answer, with exactly one unambiguous marker pair.
    [[ "$(grep -c '^BEGIN_IMPLEMENTATION_MD$' "$ANSWER" || true)" == 1 && \
       "$(grep -c '^END_IMPLEMENTATION_MD$' "$ANSWER" || true)" == 1 ]] || fail "ambiguous planning markers."

    BEGIN_LINE=$(
        grep -n '^BEGIN_IMPLEMENTATION_MD$' "$ANSWER" \
            | tail -n 1 \
            | cut -d: -f1 \
            || true
    )

    END_LINE=$(
        grep -n '^END_IMPLEMENTATION_MD$' "$ANSWER" \
            | tail -n 1 \
            | cut -d: -f1 \
