# ============================================================
# Review parser/cache
# ============================================================

load_review() {
    local FILE="$1"
    local FIELD
    for FIELD in REVIEW_STATUS REVIEW NEXT_STEP REVIEWED_SHA; do
        [[ "$(grep -c "^$FIELD: " "$FILE" || true)" == 1 ]] || return 1
    done

    STATUS_LINE=$(grep '^REVIEW_STATUS:' "$FILE" | tail -n 1 || true)
    REVIEW_LINE=$(grep '^REVIEW:' "$FILE" | tail -n 1 || true)
    NEXT_LINE=$(grep '^NEXT_STEP:' "$FILE" | tail -n 1 || true)
    SHA_LINE=$(grep '^REVIEWED_SHA:' "$FILE" | tail -n 1 || true)

    [[ -n "$STATUS_LINE" ]] || return 1
    [[ -n "$REVIEW_LINE" ]] || return 1
    [[ -n "$NEXT_LINE" ]] || return 1
    [[ -n "$SHA_LINE" ]] || return 1

    STATUS=${STATUS_LINE#REVIEW_STATUS: }
    REVIEW_TEXT=${REVIEW_LINE#REVIEW: }
    NEXT_STEP=${NEXT_LINE#NEXT_STEP: }
    REVIEWED_SHA=${SHA_LINE#REVIEWED_SHA: }

    case "$STATUS" in
        PASS|PROBLEMS|DONE|BLOCKED)
            ;;
        *)
            return 1
            ;;
    esac

    [[ -n "$REVIEW_TEXT" && -n "$NEXT_STEP" && "$REVIEWED_SHA" == "$SHA" ]] || return 1

    return 0
}

write_review_cache() {
    cat > "$CACHE_FILE.tmp.$$" <<CACHE_EOF
REVIEW_POLICY: $(adjudication policy)
REVIEW_TOKEN: $REVIEW_TOKEN
$PROGRESS_RECORD
REVIEW_IDENTITY: $REVIEW_IDENTITY
CACHE_BRANCH: $BRANCH
INPUT_BATCH: ${AUTOCYCLE_INPUT_BATCH:-}
$STATUS_LINE
$REVIEW_LINE
$NEXT_LINE
$SHA_LINE
HUMAN_ACTION: $HUMAN_ACTION
BLOCKER_KEY: $BLOCKER_KEY
INPUT_STATUS: $INPUT_STATUS
CACHE_EOF
    mv "$CACHE_FILE.tmp.$$" "$CACHE_FILE"
}

cached_review_is_valid() {
    adjudication valid "$CACHE_FILE" "${AUTOCYCLE_INPUT_BATCH:-}" || return 1
    load_review "$CACHE_FILE"

}

# ============================================================
# Review
# ============================================================

# Validate provider output in a subshell: rejected fields never reach the cache.
validate_review_response() (
    fail() { printf '%s\n' "$1"; exit 1; }
    load_review "$ANSWER" || fail "invalid Codex review: require unique REVIEW_STATUS, REVIEW, NEXT_STEP and REVIEWED_SHA matching HEAD."
    for FIELD in HUMAN_ACTION BLOCKER_KEY; do
        [[ "$(grep -c "^$FIELD: " "$ANSWER" || true)" == 1 ]] || fail "ambiguous adjudication field $FIELD."
    done
    INPUT_STATUS=$(sed -n 's/^INPUT_STATUS: //p' "$ANSWER")
    if ! python3 - "$INPUT_CONTEXT" "$INPUT_STATUS" "$REVIEW_LOG.diagnostic.json" <<'STATUS_PY'
import json,sys
context=json.loads(sys.argv[1]);received=sys.argv[2]
if received not in context['allowed']:
    # Never print arbitrary provider output or instruction text.
    safe=received if received in ('COMPLETE','PENDING','NONE') else '<malformed>'
    data=dict(context,received=safe)
    with open(sys.argv[3],'w') as f:json.dump(data,f,sort_keys=True)
    print('Instruction status: expected '+ ' | '.join(context['allowed'])+'; received '+safe+'. Diagnostic: '+sys.argv[3])
    sys.exit(1)
STATUS_PY
    then
        fail "invalid instruction completion status; review not accepted."
    fi
    [[ "$STATUS" != DONE || "$INPUT_STATUS" != PENDING ]] || fail "DONE cannot leave active instructions pending. Log: $REVIEW_LOG"
    HUMAN_ACTION=$(sed -n 's/^HUMAN_ACTION: //p' "$ANSWER")
    BLOCKER_KEY=$(sed -n 's/^BLOCKER_KEY: //p' "$ANSWER")
    [[ -n "$HUMAN_ACTION" && -n "$BLOCKER_KEY" ]] || fail "invalid adjudication fields; rerun review."
    if [[ "$STATUS" == BLOCKED ]]; then
        [[ "$HUMAN_ACTION" != NONE && "$NEXT_STEP" != NONE ]] || fail "BLOCKED lacks concrete human action."
    fi
    local SUMMARY
    SUMMARY=$(progress validate-review "$ANSWER" 2>&1) \
        || fail "invalid progress evidence; ${SUMMARY#Progress: }"
    printf '%s' "$SUMMARY"
)

run_review() {
    live_start "Review"

    local T
    local PROMPT
    local EXIT_CODE

    T=$(timestamp)
    REVIEW_LOG="$LOG_DIR/review-$T-$$.log"
    local ANSWER="$REVIEW_LOG.answer"
    REVIEW_IDENTITY=$(adjudication identity "${AUTOCYCLE_INPUT_BATCH:-}") || fail "cannot bind review evidence."
    [[ "$(adjudication context "${AUTOCYCLE_INPUT_BATCH:-}")" == "$INPUT_CONTEXT" ]] || fail "frozen input changed while constructing prompt."
    local CANDIDATE_PROMPT=""
    if [[ -f "$LOG_DIR/candidate.json" ]]; then
        CANDIDATE_PROMPT="Adjudicate the preserved candidate in $LOG_DIR/candidate.json using actual checkpointed evidence. Check branch, revision and input batch; preserve candidate history and valid partial work. Its presence or Cursor's claim does not establish a current blocker.
Reason in this order:
A. Does the candidate actually prevent the current major-Step Completion? If no, defer it, use blocking=false and BLOCKER_KEY: NONE, and do not create repair work merely because a candidate exists.
B. If it prevents Completion, is that same Completion still a sensible and achievable intermediate goal toward the Session Endpoint? If yes, keep Completion unchanged. Return PROBLEMS for a directly necessary bounded technical repair; Plan may choose a distinct continuation at Step x.y.1, then Step x.y.2, etc. Simply finishing the same attempt retains its identifier; never nest deeper.
C. Has the blocker shown that this major Step is the wrong route to the Session Endpoint? If yes, use blocking=false because a different route remains available, explain the concrete relevance reason using the existing reviewed defer_work mechanism, return to SESSION.md Endpoint and Priority, and let Plan select a genuinely different major with a new Completion. Do not weaken Completion because implementation is difficult.
D. Native Excel cached-value verification has an installed excel_verification.py copy/recalculate/verify helper. If it has not been tried for the current workbook, route to bounded implementation to run it with the existing project verifier; unattempted automation is not unavailable human access. If it failed, inspect its evidence and preserve the specific failure Action (permissions, dialog/timeout, open/calculate/save/close or verifier failure). Only structured evidence of a concrete external dependency permits BLOCKED; otherwise return PROBLEMS for bounded diagnosis or repair. Preserve checkpointed state, leave the Session incomplete, and claim neither Step Completion nor Endpoint completion.
Use stagnation as advisory context to seriously reconsider repeated unproductive approaches or the major Step's relevance. There is no threshold or ceiling and no automatic response to any value. A candidate alone never counts as a no-progress judgment. Neither deferral nor a proposed repair bypasses ownership, checkpoint, publication or recovery safeguards. Only Review decides blocker significance, progress, closure and redirection; Plan follows that decision."
    fi

    local EXCEL_EVIDENCE="${AUTOCYCLE_EXCEL_RECOVERY:-}"
    if [[ -z "$EXCEL_EVIDENCE" ]]; then
        EXCEL_EVIDENCE=$(python3 "$(dirname "$ADJUDICATOR")/excel_verification.py" --review-evidence "$SHA")
    fi

    local OFFICE_EVIDENCE
    OFFICE_EVIDENCE=$(python3 "$(dirname "$ADJUDICATOR")/native_office.py" review-evidence) || fail "cannot read native Office evidence."

    # Bash 3.2 misparses quotes in heredocs nested inside $(...). Read directly;
    # EOF is the expected nonzero read status because no NUL delimiter is sent.
    IFS= read -r -d '' PROMPT <<PROMPT_EOF || true
Review HEAD $SHA on branch $BRANCH against the current IMPLEMENTATION.md, SESSION.md and TARGET.md if present.
Fresh session deriving a new Endpoint: ${AUTOCYCLE_NEW_SESSION:-0}.
Native Excel resume verification evidence: $EXCEL_EVIDENCE.
$OFFICE_EVIDENCE
Inspect the compact Office index first and verify its SHA-256. It is a locator, not evidence acceptance. Open only the referenced receipts/results/screenshots/rendered evidence needed for the current Completion. Receipt status is evidence, never automatic acceptance; actual visual/readability evidence remains authoritative for visual claims. Check artifact_retention when present: only retained artifacts are live; pruning/pruned/unresolved artifacts cannot prove visual claims.
If relevant evidence is not indexed, search .git/autocycle/office/receipts and .git/autocycle/office/evidence narrowly, read-only, and verify request/source/revision/recovery bindings before use. Weakly bound legacy records remain on disk for this inspection. Never select evidence by file age, directory order, or a generic latest rule. Do not bulk-read the entire Office evidence store.
For opted-in projects, all new native Office interaction uses .git/autocycle/office/{excel,word}-{verify,view} slots. Never open immutable snapshots directly in Office. Historical randomized copies are not slot-lifecycle blockers; do not close or modify them. Access failures and capture failures (including black images) are infrastructure failures, not presentation/product defects; they require PROBLEMS for diagnosis unless structured evidence establishes an external dependency. Inspect validated controller receipts, retain completed implementation and immutable saved-state evidence, and do not regenerate product files merely to retry capture. Actual visible clipping/readability defects alone are presentation failures. Use authenticated current observation references and exact source/applicability bindings; historical recovery associations are provenance only. Never choose replacement evidence by age, directory order, or a generic latest-evidence rule. Historical rejected observations cannot satisfy replacement requirements. Review alone decides acceptance. Before declaring evidence materially unresolved, exhaust applicable existing evidence and supported read-only Observer inspection of checkpointed artifacts. To observe, return only OBSERVER_REQUEST: {"requests":[{"app":"word","source":"checkpointed.docx","source_sha256":"actual SHA-256"}]} (Excel additionally needs worksheet). Do not include Controller-owned fields work_id, attempt_id, recovery_id, requested_head, or request_id; Controller binds those automatically. Supported capture/navigation operations inspect fixed copies without mutating the target project. Controller authenticates the request and returns observations to this same Review, same cycle and stage timer. Do not emit a final Review verdict alongside an Observer request. Planner cannot call Observer.
If present, inspect that new evidence and its saved snapshot (the stable copy may be updated by a later attempt) when adjudicating the preserved Excel blocker. Do not replay completed work. Only Review can accept recovery or Completion; retain any other unresolved requirements.

$HUMAN_INPUT_PROMPT
$INPUT_CONTEXT_PROMPT
$STEP_INDEX_PROMPT
$PROJECT_HISTORY

Persistence and planning discipline:
- TARGET.md is the project destination. SESSION.md holds this session Endpoint and Priority. IMPLEMENTATION.md holds only current bounded work.
- During Review classify each undelivered instruction by actual effect: target, endpoint, priority, implementation; a request can affect several levels. Classify every ID still needing incorporation, using implementation for concrete execution guidance; never reuse delivered IDs. For independently satisfied inputs (INPUT_STATUS COMPLETE), use an empty direction object and do not request document changes. Record direction as a JSON object mapping those levels to exact instruction IDs in AUTOCYCLE_REVIEW. Plan follows those bindings through the existing instruction mechanism.
- If an explicit Target, Endpoint or Priority amendment makes unresolved work irrelevant, Review may include defer_work: {"work_id":"current work.id","instruction_ids":["authorizing direction instruction IDs"],"reason":"why the amendment defers this work relative to the Endpoint"}. Preserve its original plan and evidence in the ledger; deferral is not completion and cannot clear a missing-evidence block. Review may also use defer_work with empty instruction_ids after outcome NONE or VERIFIED when the evidence shows the intermediate goal is no longer a sensible route to the Session Endpoint; give the concrete relevance reason. Difficulty alone does not justify replacement. Plan may start a different major only after closure or this reviewed deferral; do not carry deferred ancestry into IMPLEMENTATION.md.
- Target changes never invent a new Endpoint. Reconcile the existing Session and report an actual conflict for a human decision. Priority-only changes leave TARGET unchanged; technique-only changes leave TARGET and SESSION unchanged.
- Endpoint and Priority persist until explicitly changed; record their changes in SESSION.md, never only in queue receipts. On an ordinary start or explicit --restart, derive a new Endpoint and Priority from TARGET, current project state and any supplied instruction. Otherwise preserve legacy work without inventing an Endpoint; normal --instruct can establish it.
- Before selecting any increment ask: "Does this materially advance the current SESSION Endpoint or unblock something required to reach it?" If no, defer it.
- Prefer the smallest direct change that can achieve the current Completion, end-to-end product capability, demonstrated current needs, reuse, and bounded repairs. Leave adequate working subsystems alone. Among valid steps choose the largest meaningful user-visible or product-level progress toward the Endpoint, governed by Priority.
- New abstractions, frameworks, compatibility machinery, hypothetical edge-case hardening and cleanup are justified only by the current Endpoint, a demonstrated defect, two or more concrete present uses, or safety/correctness of the direct implementation. Elegance alone is insufficient.
- Blocker candidates are evidence to adjudicate as a real blocker, bounded repair, or deferred work; do not recursively redesign neighboring systems.
$CANDIDATE_PROMPT

Permanent blocker policy:
- Implementation-reported blockers and planning-scope dead ends are candidates, not final decisions.
- Review may authorize bounded technical repairs and expansion of MACHINE-GENERATED file restrictions within the existing user-authorized goal. Return PROBLEMS and describe that repair for Plan.
- Never override explicit user constraints, permissions or access controls. TARGET changes require explicit user instruction. Human decisions and unavailable access remain BLOCKED.
- Never invent missing evidence, source data, measurements or successful completion. A green test that expects a blocker does not establish the parent Completion.
- BLOCKED means required progress depends on a concrete external action the authorized runtime cannot perform. Unattempted implementation/testing/rendering/capture/inspection is PROBLEMS. Repairable or ambiguous failure is PROBLEMS for diagnosis/repair/retry; an unresolved material fact is PROBLEMS for Plan to select a finite supported route. Capability absence must stop before Implement, never become capability diagnosis project work.
- Neither missing evidence nor optimistic prose (Access ✓, Office installed, renderer exists) establishes capability availability or unavailability. Inspect structured controller/runtime receipts and their input bindings.
- BLOCKED requires external_blocker: {fact, route, action, evidence:[{path,sha256,observation}]}. Cite a factual JSON receipt containing reviewed_head equal to HEAD and external_dependency: {fact,route,action,kind,check,inputs:[{path,sha256,observation}]}. kind is permission/access/external_artifact/external_approval; check is attempted/deterministic. The receipt must establish the external dependency for the required fact and checked autonomous route. Do not create receipts during Review or infer external action from generic failure kinds. HUMAN_ACTION and NEXT_STEP must equal the exact evidenced action.
- BLOCKER_KEY is a stable short identifier for a current blocking finding; reuse it across equivalent repair attempts, regardless of step numbering. When AUTOCYCLE_REVIEW.blocking is false, NONE is allowed, including after a preserved candidate is resolved. Blocking findings require PROBLEMS or BLOCKED and a non-NONE key.
- INPUT_STATUS concerns delivery of one-time steering: PENDING if any request still needs incorporation into a Plan, COMPLETE if every request is incorporated in a published Plan or independently verified satisfied, NONE for an empty frozen snapshot. Input consumption never establishes implementation acceptance; verify the original plan and all unfinished work separately.
- Review is read-only. Only Plan can revise planning documents under explicit instruction authority; Cursor keeps TARGET.md, SESSION.md and IMPLEMENTATION.md read-only.
- Local evidence may be uncommitted or unpushed after unsafe/failed checkpointing. Diagnose it without requiring a push; do not call preservation successful implementation.

Inspect only what is necessary:
- latest implementation diff
- changed files
- directly relevant tests/evidence
- $LOG_DIR/latest-implementation, if present: verify its branch and implementation baseline against HEAD or the preceding checkpoint (baseline must be an ancestor and the intervening commit must record this implementation). Assess the log and actual diff; do not ignore preceding implementation evidence merely because Checkpoint advanced HEAD. Missing or mismatched evidence cannot establish acceptance.
- Read the same IMPLEMENTATION.md that Cursor followed, Cursor's RESULT.md and measured verification evidence, and the actual resulting diff/state. Cursor's completion claim is evidence, never an automatic pass.
- Distinguish a requirement the plan stated but Cursor missed, something genuinely necessary that the plan omitted, and an additional improvement. If it is not required for this Step or Session Endpoint, defer it. Do not manufacture formal acceptance conditions for a prose plan.
- An implementation may legitimately produce no diff; evaluate the actual plan requirements against current files and evidence.
- If $LOG_DIR/remote-docs-current.json exists and its merged revision is HEAD, inspect its receipt and retained executed/remote plans. The merge preserves implementation work and imports owner-authored planning edits; it does not establish acceptance. Assess current behavior against the UPDATED TARGET and plan, including new requirements. Compare progress against the recorded original work objective; do not invent completion, replay one-time instructions, or require separation of the already-proven disjoint Git changes. Record any remaining implementation or acceptance gap for Plan.

Avoid broad repository scans unless needed.

Do not modify files, implement, commit, push, or narrate your investigation.

Return ONLY:

REVIEW_STATUS: PASS | PROBLEMS | DONE | BLOCKED
REVIEW: <maximum 25 words: a concise finding normally; for DONE, a single line describing what this Session completed>
NEXT_STEP: <one bounded next step, maximum 30 words, or NONE>
REVIEWED_SHA: $SHA
HUMAN_ACTION: <concrete human action for BLOCKED, otherwise NONE>
BLOCKER_KEY: <stable obstacle identifier, or NONE>
