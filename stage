# ============================================================
# Checkpoint
# ============================================================

run_checkpoint() {
    local OUTPUT
    local BEFORE

    BEFORE=$(git rev-parse HEAD)

    assert_owned_docs "$BEFORE"
    if [[ -z "$(git status --porcelain)" ]]; then
        BRANCH=$(git branch --show-current)
        git fetch origin "$BRANCH" >/dev/null 2>&1 || fail "could not verify no-change checkpoint."
        [[ "$(git rev-parse "origin/$BRANCH")" == "$BEFORE" ]] || fail "no-change HEAD is not on GitHub."
        CHECKPOINT_SHA="$BEFORE"
        CHECKPOINT_SHORT="skipped (no changes)"
        rm -f "$CACHE_FILE"
        return 0
    fi
    if ! OUTPUT=$(checkpoint 2>&1); then
        echo "$OUTPUT"
        fail "checkpoint"
    fi

    CHECKPOINT_SHA=$(git rev-parse HEAD)
    CHECKPOINT_SHORT=$(git rev-parse --short HEAD)

    [[ "$CHECKPOINT_SHA" != "$BEFORE" ]] \
        || fail "checkpoint created no commit."

    BRANCH=$(git branch --show-current)

    git fetch origin "$BRANCH" >/dev/null 2>&1 \
        || fail "could not verify checkpoint."

    [[ "$(git rev-parse "origin/$BRANCH")" == "$CHECKPOINT_SHA" ]] \
        || fail "checkpoint is not on GitHub."
}

