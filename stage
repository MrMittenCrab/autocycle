// autocycle completion guard v2
function validateCompletion(result, items) {
  if (result?.stopReason !== "end_turn") {
    throw new Error("Cursor did not finish normally: " +
      (result?.stopReason || "missing stopReason"));
  }
  if (!items.length) {
    throw new Error("Cursor supplied no task completion evidence.");
  }
  const unfinished = items.find(item =>
    !["completed", "cancelled"].includes(item.status));
  if (unfinished) {
    throw new Error("Cursor stopped with unfinished or unknown task: " +
      unfinished.content + " [" + String(unfinished.status) + "]");
  }
  if (!items.some(item => item.status === "completed")) {
    throw new Error("Cursor cancelled every task; implementation unverified.");
  }
}

// Classify the terminal provider message before completion-marker validation.
// Keep the allowlist narrow: ordinary markerless end_turn still fails closed.
function providerRetriableError() {
  const lastMessage = response.messages[response.messages.length - 1] || "";
  return transportError(lastMessage) || /^\s*(?:Error: )?RetriableError: \[resource_exhausted\] Error\s*$/.test(lastMessage)
    ? lastMessage.trim() : "";
}

async function main() {
  try {
    await send("initialize", {
      protocolVersion: 1,
      clientCapabilities: {
        fs: {
          readTextFile: false,
          writeTextFile: false
        },
        terminal: false
      },
      clientInfo: {
        name: "autocycle",
        version: "1.0.0"
      }
    });

    await send("authenticate", {
      methodId: "cursor_login"
    });

    const session = await send("session/new", {
      cwd: root,
      mcpServers: []
    });

    const result = await send("session/prompt", {
      sessionId: session.sessionId,
      prompt: [{
        type: "text",
        text: prompt
      }]
    });

    log.write(`\n[result] stopReason=${result?.stopReason || "unknown"}\n`);
    const providerError = providerRetriableError();
    if (providerError) {
      throw new Error("Provider RetriableError: " + providerError + ". Evidence preserved.");
    }
    const responseText = response.text();
    if (/^OBSERVER_REQUEST:/m.test(responseText)) {
      if (result?.stopReason !== "end_turn") throw new Error("Observer request requires a normal provider return");
      shuttingDown = true;
      agent.stdin.end();
      try { process.kill(-agent.pid, "SIGTERM"); } catch {}
      const stopped = await new Promise(resolve => {
        if (agentClosed) return resolve(true);
        const timeout = setTimeout(() => resolve(false), 5000);
        agent.once("close", () => { clearTimeout(timeout); resolve(true); });
      });
      if (!stopped || git("rev-parse", "HEAD") !== beforeSha || git("branch", "--show-current") !== beforeBranch)
        throw new Error("Observer continuation could not authenticate stopped provider ownership");
      execFileSync("python3", [adjudicator, "observe-request", "Implement"], {input:responseText});
      clearInterval(timer);
      log.end(() => process.exit(77));
      return;
    }
    if (/NATIVE_HANDOFF|Controller capture delegated/.test(responseText) ||
        todoOrder.some(id => todos.get(id)?.content === 'Controller capture delegated'))
      throw new Error("Legacy native delegation is not accepted for new work");
    const statuses = [...responseText.matchAll(/^IMPLEMENT_STATUS: (COMPLETE|BLOCKED)\s*$/gm)];
    if (result?.stopReason !== "end_turn" || statuses.length !== 1) {
      throw new Error("Implementation response rejected: stopReason=" +
        (result?.stopReason || "missing") + "; status markers=" + statuses.length +
        ". Evidence preserved.");
    }
    const blocked = statuses[0][1] === "BLOCKED";
    if (!blocked) validateCompletion(result, todoOrder.map(id => todos.get(id)).filter(Boolean));
    if (blocked && !/^BLOCKER: \S.+/m.test(responseText)) {
      throw new Error("Implementation blocker has no concrete reason.");
    }
    if (git("branch", "--show-current") !== beforeBranch) {
      throw new Error("Cursor switched Git branches.");
    }
    const afterSha = git("rev-parse", "HEAD");

    if (afterSha !== beforeSha) {
      throw new Error(
        "Cursor changed Git HEAD."
      );
    }

    const changes = git("status", "--porcelain");

    if (!changes) {
      log.write("\n[result] no_changes=true; normal completion accepted\n");
    }

    if (blocked) {
      clearInterval(timer);
      shuttingDown = true;
      agent.stdin.end();
      agent.kill();
      redraw(true);
      if (process.env.AUTOCYCLE_CONTROLLER_REVIEW === '1') display.outcome('↪');
      else display.finish('↪');
      display.event("◇ Blocker candidate: " + (responseText.match(/BLOCKER: ([^\n]+)/)?.[1] || "implementation needs Review"));
      log.end(() => process.exit(42));
      return;
    }
    finished = true;

    clearInterval(timer);
    redraw(true);

    log.write(
      `\n[result] stopReason=${result?.stopReason || "unknown"}\n`
    );

    shuttingDown = true;
    agent.stdin.end();
    agent.kill();
    log.end();

  } catch (err) {
    clearInterval(timer);

    log.write(
      `\n[error] ${err?.stack || String(err)}\n`
    );

    shuttingDown = true;

    try {
      agent.stdin.end();
      process.kill(-agent.pid, "SIGTERM");
    } catch {}

    const sameHead =
      git("rev-parse", "HEAD") === beforeSha;

    // Wait for the ACP process and its inherited output streams to close before
    // the shell fingerprints partial work. No receipt on uncertain shutdown.
    const stopped = await new Promise(resolve => {
      if (agentClosed) return resolve(true);
      const timeout = setTimeout(() => resolve(false), 5000);
      agent.once("close", () => { clearTimeout(timeout); resolve(true); });
    });
    const transportFailure = providerRetriableError();

    const safeToRetry =
      (retryableStall || transportFailure) && stopped && sameHead &&
      git("branch", "--show-current") === beforeBranch;

    display.clearTimer();
    if (safeToRetry) {
      if (transportFailure) display.event("Provider RetriableError: " + transportFailure);
      redraw();
    } else {
      display.finish('✗');
      process.stderr.write("\n");
      process.stderr.write(
        `✗ ${err?.message || String(err)}\n`
      );
      process.stderr.write(`Log: ${logFile}\n`);
    }

    // Flush the recorded completion reason/error before exiting the Node process.
    log.end(() => process.exit(safeToRetry ? (retryableStall || transportError(transportFailure) ? 75 : 79) : 1));
  }
}

