#!/bin/bash
set -euo pipefail
ADJUDICATOR="$HOME/.autocycle/adjudication.py"
adjudication() { python3 "$ADJUDICATOR" "$@"; }
progress() { python3 "$(dirname "$ADJUDICATOR")/progress.py" "$@"; }

usage() {
    echo "Usage:"
    echo "  autocycle <cycles>"
    echo "  autocycle <cycles> --dry-run"
    echo "  autocycle --review-only"
    echo "  autocycle --plan-only"
    echo "  autocycle --implement-only"
    exit 1
}

LIVE_TIMER_PID=""
LIVE_TIMER_LABEL=""
LIVE_TIMER_START=0

# AUTOCYCLE_TIMER_CLEANUP_V1
live_stop_timer() {
    if [[ -n "${LIVE_TIMER_PID:-}" ]]; then
        kill "$LIVE_TIMER_PID" >/dev/null 2>&1 || true
        wait "$LIVE_TIMER_PID" >/dev/null 2>&1 || true
        LIVE_TIMER_PID=""
    fi
}

trap live_stop_timer EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

format_elapsed() {
    local NOW="$1"
    local START="$2"
    local SECONDS_ELAPSED=$((NOW - START))

    printf "%02d:%02d" \
        "$((SECONDS_ELAPSED / 60))" \
        "$((SECONDS_ELAPSED % 60))"
}

live_start() {
    local LABEL="$1"
    local TIMER_OWNER_PID="$$"

    live_stop_timer

    LIVE_TIMER_LABEL="$LABEL"
    LIVE_TIMER_START=$(date +%s)

    (
        while kill -0 "$TIMER_OWNER_PID" 2>/dev/null; do
            if [[ -t 1 ]]; then
                NOW=$(date +%s)
                TIME=$(format_elapsed "$NOW" "$LIVE_TIMER_START")

                printf "\r%-12s%s" "$LABEL" "$TIME"
            fi

            sleep 1
        done
    ) &

    LIVE_TIMER_PID=$!
}

live_finish() {
    local SYMBOL="$1"
    local SUMMARY="${2:-}"

    if [[ -n "${LIVE_TIMER_PID:-}" ]]; then
        kill "$LIVE_TIMER_PID" >/dev/null 2>&1 || true
        wait "$LIVE_TIMER_PID" >/dev/null 2>&1 || true
    fi

    local NOW
    local TIME

    NOW=$(date +%s)
    TIME=$(format_elapsed "$NOW" "$LIVE_TIMER_START")

    if [[ -t 1 ]]; then
        printf "\r\033[2K"
    fi

    printf "%-12s%s %s\n" \
        "$LIVE_TIMER_LABEL" \
        "$SYMBOL" \
        "$TIME"

    if [[ -n "$SUMMARY" ]]; then
        echo "    $SUMMARY"
    fi

    LIVE_TIMER_PID=""
    LIVE_TIMER_LABEL=""
    LIVE_TIMER_START=0
}

live_done() {
    live_finish "✓" "${1:-}"
}

live_fail() {
    live_finish "✗"
}

fail() {
    if [[ -n "${LIVE_TIMER_PID:-}" ]]; then
        live_fail
    fi

    echo
    echo "FAILED: $1"
    exit 1
}

# ============================================================
# Arguments
# ============================================================

MODE="--run"
MAX_CYCLES=1

if [[ $# -eq 1 ]]; then
    if [[ "$1" =~ ^[1-9][0-9]*$ ]]; then
        MAX_CYCLES="$1"
    else
        MODE="$1"
    fi
elif [[ $# -eq 2 ]]; then
    MAX_CYCLES="$1"
    MODE="$2"

    if ! [[ "$MAX_CYCLES" =~ ^[1-9][0-9]*$ ]]; then
        usage
    fi
elif [[ $# -gt 2 ]]; then
    usage
fi

case "$MODE" in
    --run|--dry-run|--review-only|--plan-only|--implement-only)
        ;;
    *)
        usage
        ;;
esac

# ============================================================
# Repository
# ============================================================

if [[ "$MODE" == "--run" ]]; then
    exec "$HOME/bin/autocycle" "$MAX_CYCLES"
fi

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
    fail "not inside a Git repository."
}

cd "$ROOT"

command -v git >/dev/null 2>&1 || fail "git not found."

needs_codex=0
needs_cursor=0

case "$MODE" in
    --run)
        needs_codex=1
        needs_cursor=1
        ;;
    --review-only|--plan-only)
        needs_codex=1
        ;;
    --implement-only)
        needs_cursor=1
        ;;
esac

if [[ "$needs_codex" -eq 1 ]]; then
    command -v codex >/dev/null 2>&1 || fail "codex not found."

    AUTH=$(codex login status 2>&1 || true)

    if [[ "$AUTH" != *"Logged in using ChatGPT"* ]]; then
        fail "Codex is not authenticated using ChatGPT."
    fi
fi

if [[ "$needs_cursor" -eq 1 ]]; then
    command -v agent >/dev/null 2>&1 || fail "Cursor agent not found."
    command -v node >/dev/null 2>&1 || fail "Node.js not found."
fi

if [[ "$MODE" == "--run" ]]; then
    command -v sync >/dev/null 2>&1 || fail "sync not found."
    command -v checkpoint >/dev/null 2>&1 || fail "checkpoint not found."
fi

# ============================================================
# State
# ============================================================

BRANCH=""
SHA=""
SHORT_SHA=""
REMOTE_SHA=""

refresh_state() {
    if [[ "$MODE" == "--review-only" && "${AUTOCYCLE_LOCAL_REVIEW:-0}" == 1 ]]; then
        BRANCH=$(git branch --show-current)
        [[ -n "$BRANCH" ]] || fail "detached HEAD; local evidence preserved."
        SHA=$(git rev-parse HEAD)
        SHORT_SHA=$(git rev-parse --short HEAD)
        return
    fi
    BRANCH=$(git branch --show-current)

    [[ -n "$BRANCH" ]] || fail "detached HEAD."

    if [[ -n "$(git status --porcelain)" ]]; then
        if [[ "$MODE" == "--implement-only" \
           && "${AUTOCYCLE_ALLOW_DIRTY:-0}" == "1" ]]; then
            :
        else
            echo "Working tree:"
            git status --short
            fail "working tree is not clean."
        fi
    fi

    git fetch --prune origin >/dev/null 2>&1 \
        || fail "could not fetch origin."

    SHA=$(git rev-parse HEAD)
    SHORT_SHA=$(git rev-parse --short HEAD)

    if ! git show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
        fail "origin/$BRANCH does not exist."
    fi

    REMOTE_SHA=$(git rev-parse "origin/$BRANCH")

    if [[ "$REMOTE_SHA" != "$SHA" ]]; then
        echo "Local:  $SHA"
        echo "Remote: $REMOTE_SHA"
        fail "local branch and GitHub are not synchronized."
    fi
}

refresh_state

# ============================================================
# Storage
# ============================================================

LOG_DIR=$(git rev-parse --git-path autocycle)
if [[ "$LOG_DIR" != /* ]]; then LOG_DIR="$ROOT/$LOG_DIR"; fi
mkdir -p "$LOG_DIR"

CACHE_FILE="$LOG_DIR/current-review"
QUEUE_HELPER="$HOME/.autocycle/instructions.py"
HUMAN_INPUT_PROMPT=""
INPUT_CONTEXT=$(adjudication context "${AUTOCYCLE_INPUT_BATCH:-}") || fail "could not verify frozen input context."
INPUT_COUNT=$(python3 -c 'import json,sys;print(json.loads(sys.argv[1])["count"])' "$INPUT_CONTEXT")
EXPECTED_INPUT_STATUS=NONE
VERIFIED_INPUT_KEY=""
if (( INPUT_COUNT > 0 )); then
    VERIFIED_INPUT_KEY="${AUTOCYCLE_INPUT_BATCH}"
    EXPECTED_INPUT_STATUS="COMPLETE | PENDING"
fi
[[ "${AUTOCYCLE_INPUT_KEY:-}" == "$VERIFIED_INPUT_KEY" ]] || fail "instruction key disagrees with verified frozen context."
case "$MODE" in
    --review-only|--plan-only)
        if [[ -n "$VERIFIED_INPUT_KEY" ]]; then
            HUMAN_INPUT_PROMPT=$(python3 "$QUEUE_HELPER" --dir "$LOG_DIR" prompt "$VERIFIED_INPUT_KEY") \
                || fail "could not load frozen human input."
        fi
        ;;
esac
INPUT_CONTEXT_PROMPT="Verified frozen input context for this invocation:
Active instructions: $INPUT_COUNT
Allowed INPUT_STATUS: $EXPECTED_INPUT_STATUS
An empty batch is NOT an active instruction. Repository goals, unresolved implementation work and historical logs do not count as active queued instructions. Use only the allowed status values above."

# Controller-owned step identity; history is imported once from executed headings.
STEP_INDEX_PROMPT=""
case "$MODE" in
    --review-only|--plan-only)
        WORK_CONTEXT=$(progress context "${AUTOCYCLE_INPUT_BATCH:-}") || fail "cannot load work registry."
        STEP_INDEX_PROMPT="
Step indexing:
AUTOCYCLE_WORK_CONTEXT: $WORK_CONTEXT
- The controller registry is authoritative. Mentions, suggestions and reservations never consume a step ID. Never reserve or certify a prospective next ID in RESULT.md.
- Only Plan revises IMPLEMENTATION.md; retain the original acceptance criteria of unresolved work. Retries, repairs and administrative corrections keep that work's existing ID; do not create numbered repair children.
- Preserve detailed project IDs; do not collapse an existing detailed ID into a broad phase. The controller assigns a new ID only when admitting genuinely new work after verified completion of the previous objective.
- Numbering and wording discrepancies alone are advisory. Do not open another numbering repair unless the discrepancy prevents execution or makes acceptance materially ambiguous; explain the concrete consequence.
- Do not reconstruct consumed IDs from prose or reserved numbers. Historical registry entries mark execution, not verified acceptance.
"
        ;;
esac

timestamp() {
    date +%Y%m%d-%H%M%S
}

STATUS_LINE=""
REVIEW_LINE=""
NEXT_LINE=""
SHA_LINE=""

STATUS=""
REVIEW_TEXT=""
NEXT_STEP=""
REVIEWED_SHA=""

REVIEW_LOG=""
PLAN_LOG=""
PLAN_FILE=""

PLAN_SHA=""
PLAN_SHORT_SHA=""
PLAN_TITLE=""

CHECKPOINT_SHA=""
CHECKPOINT_SHORT=""

# ============================================================
# Review parser/cache
# ============================================================

load_review() {
    local FILE="$1"
    local FIELD
    for FIELD in REVIEW_STATUS REVIEW NEXT_STEP REVIEWED_SHA; do
        [[ "$(grep -c "^$FIELD: " "$FILE" || true)" == 1 ]] || return 1
    done

    STATUS_LINE=$(grep '^REVIEW_STATUS:' "$FILE" | tail -n 1 || true)
    REVIEW_LINE=$(grep '^REVIEW:' "$FILE" | tail -n 1 || true)
    NEXT_LINE=$(grep '^NEXT_STEP:' "$FILE" | tail -n 1 || true)
    SHA_LINE=$(grep '^REVIEWED_SHA:' "$FILE" | tail -n 1 || true)

    [[ -n "$STATUS_LINE" ]] || return 1
    [[ -n "$REVIEW_LINE" ]] || return 1
    [[ -n "$NEXT_LINE" ]] || return 1
    [[ -n "$SHA_LINE" ]] || return 1

    STATUS=${STATUS_LINE#REVIEW_STATUS: }
    REVIEW_TEXT=${REVIEW_LINE#REVIEW: }
    NEXT_STEP=${NEXT_LINE#NEXT_STEP: }
    REVIEWED_SHA=${SHA_LINE#REVIEWED_SHA: }

    case "$STATUS" in
        PASS|PROBLEMS|DONE|BLOCKED)
            ;;
        *)
            return 1
            ;;
    esac

    [[ -n "$REVIEW_TEXT" && -n "$NEXT_STEP" && "$REVIEWED_SHA" == "$SHA" ]] || return 1

    return 0
}

write_review_cache() {
    cat > "$CACHE_FILE.tmp.$$" <<CACHE_EOF
REVIEW_POLICY: five-stage-progress-v3
REVIEW_TOKEN: $REVIEW_TOKEN
$PROGRESS_RECORD
REVIEW_IDENTITY: $REVIEW_IDENTITY
CACHE_BRANCH: $BRANCH
INPUT_BATCH: ${AUTOCYCLE_INPUT_BATCH:-}
$STATUS_LINE
$REVIEW_LINE
$NEXT_LINE
$SHA_LINE
HUMAN_ACTION: $HUMAN_ACTION
BLOCKER_KEY: $BLOCKER_KEY
INPUT_STATUS: $INPUT_STATUS
CACHE_EOF
    mv "$CACHE_FILE.tmp.$$" "$CACHE_FILE"
}

cached_review_is_valid() {
    adjudication valid "$CACHE_FILE" "${AUTOCYCLE_INPUT_BATCH:-}" || return 1
    load_review "$CACHE_FILE"

}

# ============================================================
# Review
# ============================================================

run_review() {
    live_start "Review"

    local T
    local PROMPT
    local EXIT_CODE

    T=$(timestamp)
    REVIEW_LOG="$LOG_DIR/review-$T-$$.log"
    local ANSWER="$REVIEW_LOG.answer"
    REVIEW_IDENTITY=$(adjudication identity "${AUTOCYCLE_INPUT_BATCH:-}") || fail "cannot bind review evidence."
    [[ "$(adjudication context "${AUTOCYCLE_INPUT_BATCH:-}")" == "$INPUT_CONTEXT" ]] || fail "frozen input changed while constructing prompt."
    local CANDIDATE_PROMPT=""
    if [[ -f "$LOG_DIR/candidate.json" ]]; then
        CANDIDATE_PROMPT="Adjudicate the blocker candidate in $LOG_DIR/candidate.json. Inspect its preserved report and relevant local changes; the report is evidence, not authority. Check recorded branch, revision and input batch; stale evidence cannot establish current acceptance. Return PROBLEMS for an authorized bounded repair or BLOCKED with a concrete human action. Do not return PASS or DONE for an unresolved candidate."
    fi

    # Bash 3.2 misparses quotes in heredocs nested inside $(...). Read directly;
    # EOF is the expected nonzero read status because no NUL delimiter is sent.
    IFS= read -r -d '' PROMPT <<PROMPT_EOF || true
Review HEAD $SHA on branch $BRANCH against the current IMPLEMENTATION.md and TARGET.md if present.

$HUMAN_INPUT_PROMPT
$INPUT_CONTEXT_PROMPT
$STEP_INDEX_PROMPT
$CANDIDATE_PROMPT

Permanent blocker policy:
- Implementation-reported blockers and planning-scope dead ends are candidates, not final decisions.
- Review may authorize bounded technical repairs and expansion of MACHINE-GENERATED file restrictions within the existing user-authorized goal. Return PROBLEMS and describe that repair for Plan.
- Never override explicit user constraints, TARGET.md, permissions or access controls. Human decisions and unavailable access remain BLOCKED.
- Never invent missing evidence, source data, measurements or successful completion. A green test that expects a blocker does not satisfy original acceptance.
- For BLOCKED, HUMAN_ACTION must specify exactly what the human must decide, provide or grant; NEXT_STEP must describe that action.
- BLOCKER_KEY is a stable short identifier for the underlying obstacle; reuse it across equivalent repair attempts, regardless of step numbering.
- INPUT_STATUS describes the entire frozen human instruction batch, not just the current step: PENDING if any requested work remains (including work carried forward in the plan), COMPLETE only with evidence that every request is satisfied, NONE when no active instructions are supplied.
- Review is read-only. Only Plan can revise IMPLEMENTATION.md; Cursor keeps it and TARGET.md read-only.
- Local evidence may be uncommitted or unpushed after unsafe/failed checkpointing. Diagnose it without requiring a push; do not call preservation successful implementation.

Inspect only what is necessary:
- latest implementation diff
- changed files
- directly relevant tests/evidence
- $LOG_DIR/latest-implementation, if present: verify its branch and implementation baseline against HEAD or the preceding checkpoint (baseline must be an ancestor and the intervening commit must record this implementation). Assess the log and actual diff; do not ignore preceding implementation evidence merely because Checkpoint advanced HEAD. Missing or mismatched evidence cannot establish acceptance.
- An implementation may legitimately produce no diff; evaluate acceptance against the current files and evidence.

Avoid broad repository scans unless needed.

Do not modify files, implement, commit, push, or narrate your investigation.

Return ONLY:

REVIEW_STATUS: PASS | PROBLEMS | DONE | BLOCKED
REVIEW: <maximum 25 words>
NEXT_STEP: <one bounded next step, maximum 30 words, or NONE>
REVIEWED_SHA: $SHA
HUMAN_ACTION: <concrete human action for BLOCKED, otherwise NONE>
BLOCKER_KEY: <stable obstacle identifier, or NONE>
INPUT_STATUS: $EXPECTED_INPUT_STATUS
AUTOCYCLE_REVIEW: <one JSON object as specified below>

AUTOCYCLE_REVIEW must contain:
- work_id and attempt_id: echo the controller work.id and attempt.id in AUTOCYCLE_WORK_CONTEXT; use "NONE" when absent. Never invent a replacement identity to escape unresolved work.
- finding_key: the stable underlying finding, retaining the current work's key while unresolved.
- blocking: JSON true only for consequences preventing correctness, execution, verification or acceptance. blocking_reason: the concrete consequence, otherwise "NONE".
- outcome: "UNASSESSED" only when no checkpointed attempt exists; otherwise "VERIFIED" for measured improvement against the ORIGINAL objective, "COMPLETE" for verified satisfaction of its success criterion, "NONE" for no improvement, or "UNKNOWN" when evidence is insufficient.
- reason: explain how the observed result compares with work.baseline and work.success. A commit, changed file, new test, rewritten status, changed ID or regenerated artifact alone is never progress. Documentation and investigation count when they satisfy the actual objective.
- evidence: a JSON array of objects with path, sha256 (the actual current file SHA-256), and observation (the concrete test/measurement/result relevant to the original criterion). VERIFIED and COMPLETE require evidence you actually inspected. Paths must be in the repository or its AutoCycle evidence directory. Evidence can be a test log, structured metrics or the actual document/artifact; do not invent paths or hashes. Do not modify files to create evidence during Review.
- recovery: "NONE" normally. If blocked, "NEW_EVIDENCE" requires verified progress backed by newly inspected evidence; "REVISED_APPROACH" requires explicit new human instructions authorizing a concrete different approach, with recovery_instruction_ids drawn from new_instruction_ids and a concrete recovery_reason. Mere reruns or unrelated new instructions do not clear a block.
- recovery_instruction_ids: [] unless using REVISED_APPROACH. recovery_reason: "NONE" unless recovering.
If verification_only is true, this is the single read-only recheck of missing evidence. Do not propose implementation to fix the progress mechanism; unresolved uncertainty will stop execution.
DONE requires current-work COMPLETE when an attempt exists. If all TARGET work and frozen instructions are complete, return DONE; unused cycle budget is not a reason to invent work.
PROBLEMS with blocking=false records advisory findings; Plan should select the highest-priority authorized objective, not a recursive administrative repair.
PROMPT_EOF
    PROMPT=${PROMPT%$'\n'}

    set +e
    adjudication run "${AUTOCYCLE_PROVIDER_TIMEOUT:-900}" codex exec --sandbox read-only --output-last-message "$ANSWER" "$PROMPT" \
        >"$REVIEW_LOG" 2>&1
    EXIT_CODE=$?
    set -e

    if [[ "$EXIT_CODE" -ne 0 ]]; then
        echo "Review provider unsuccessful (exit $EXIT_CODE; 124 means timed out). Log: $REVIEW_LOG"
        fail "Codex review. Log: $REVIEW_LOG"
    fi

    load_review "$ANSWER" \
        || fail "invalid Codex review. Log: $REVIEW_LOG"

    [[ "$(git rev-parse HEAD)" == "$SHA" ]] \
        || fail "HEAD changed during review."

    [[ "$(adjudication identity "${AUTOCYCLE_INPUT_BATCH:-}")" == "$REVIEW_IDENTITY" ]] \
        || fail "repository or evidence changed during review; decision discarded."
    for FIELD in HUMAN_ACTION BLOCKER_KEY; do
        [[ "$(grep -c "^$FIELD: " "$ANSWER" || true)" == 1 ]] || fail "ambiguous adjudication field $FIELD."
    done
    INPUT_STATUS=$(sed -n 's/^INPUT_STATUS: //p' "$ANSWER")
    if ! python3 - "$INPUT_CONTEXT" "$INPUT_STATUS" "$REVIEW_LOG.diagnostic.json" <<'STATUS_PY'
import json,sys
context=json.loads(sys.argv[1]);received=sys.argv[2]
if received not in context['allowed']:
    # Never print arbitrary provider output or instruction text.
    safe=received if received in ('COMPLETE','PENDING','NONE') else '<malformed>'
    data=dict(context,received=safe)
    with open(sys.argv[3],'w') as f:json.dump(data,f,sort_keys=True)
    print('Instruction status: expected '+ ' | '.join(context['allowed'])+'; received '+safe+'. Diagnostic: '+sys.argv[3])
    sys.exit(1)
STATUS_PY
    then
        fail "invalid instruction completion status; review not accepted."
    fi
    [[ "$STATUS" != DONE || "$INPUT_STATUS" != PENDING ]] || fail "DONE cannot leave active instructions pending. Log: $REVIEW_LOG"
    HUMAN_ACTION=$(sed -n 's/^HUMAN_ACTION: //p' "$ANSWER")
    BLOCKER_KEY=$(sed -n 's/^BLOCKER_KEY: //p' "$ANSWER")
    [[ -n "$HUMAN_ACTION" && -n "$BLOCKER_KEY" ]] || fail "invalid adjudication fields; rerun review."
    if [[ "$STATUS" == BLOCKED ]]; then
        [[ "$HUMAN_ACTION" != NONE && "$NEXT_STEP" != NONE ]] || fail "BLOCKED lacks concrete human action."
    fi
    if [[ -f "$LOG_DIR/candidate.json" ]]; then
        [[ "$STATUS" == PROBLEMS || "$STATUS" == BLOCKED ]] || fail "candidate needs PROBLEMS or BLOCKED adjudication."
        [[ "$BLOCKER_KEY" != NONE ]] || fail "candidate lacks stable blocker key."
    fi

    progress validate-review "$ANSWER" || fail "invalid progress evidence; Review not accepted."
    REVIEW_TOKEN=$(python3 -c 'import uuid;print(uuid.uuid4().hex)')
    PROGRESS_RECORD=$(sed -n '/^AUTOCYCLE_REVIEW: /p' "$ANSWER")
    printf '\nAUTOCYCLE_REVIEW_INPUT: %s\n' "${AUTOCYCLE_INPUT_KEY:-}" >> "$REVIEW_LOG"
    write_review_cache

    live_done "Found: $REVIEW_TEXT"
}

# ============================================================
# Plan
# ============================================================

run_plan() {
    local GUARD_RESULT GUARD_RC
    set +e
    GUARD_RESULT=$(progress guard "$CACHE_FILE" "${AUTOCYCLE_INPUT_BATCH:-}")
    GUARD_RC=$?
    set -e
    if [[ "$GUARD_RC" != 0 ]]; then
        echo "BLOCKED     $GUARD_RESULT"
        exit "$GUARD_RC"
    fi
    live_start "Plan"

    local T
    local PROMPT
    local EXIT_CODE
    local BEGIN_LINE
    local END_LINE
    local FIRST_LINE

    T=$(timestamp)
    PLAN_LOG="$LOG_DIR/plan-$T-$$.log"
    local ANSWER="$PLAN_LOG.answer"
    PLAN_FILE="$LOG_DIR/IMPLEMENTATION-$T.md"

    IFS= read -r -d '' PROMPT <<PROMPT_EOF || true
Create the next IMPLEMENTATION.md from:

SHA: $SHA
STATUS: $STATUS
REVIEW: $REVIEW_TEXT
NEXT_STEP: $NEXT_STEP
$(sed -n '/^AUTOCYCLE_REVIEW: /p' "$CACHE_FILE")

$HUMAN_INPUT_PROMPT
$STEP_INDEX_PROMPT
Read existing IMPLEMENTATION.md, TARGET.md, and directly relevant files only as needed.

Rules:
- One bounded implementation step.
- Review can authorize bounded technical repair and expansion of machine-generated file restrictions within the existing user-authorized goal. It cannot override explicit user constraints, TARGET.md, permissions or access controls.
- Preserve the current work identity and ORIGINAL acceptance criteria for retries and repairs. Administrative corrections use the same work ID and never create numbered children.
- Missing evidence must not be invented; human decisions and unavailable access remain blockers.
- If no authorized bounded plan is possible, output PLAN_STATUS: BLOCKED followed by BLOCKER: <concrete reason>, without a plan block. This is a candidate for read-only Review, not a final decision.
- Cursor must never modify TARGET.md or IMPLEMENTATION.md.
- Direct completion records and measured verification to RESULT.md.
- Read RESULT.md when assessing the previous step.
- Repair blocking correctness, execution, verification or acceptance defects before advancing. Record advisory findings and choose the highest-priority remaining authorized work. Numbering or wording alone cannot demand another implementation cycle.
- Preserve useful project-specific naming/conventions.
- Prefer 2-4 concrete tasks.
- Include only necessary files, actions, tests, and acceptance criteria.
- Omit rationale, history, repetition, and obvious instructions.
- Aim for no more than about 60 lines.
- Do not implement, modify files, commit, or push.
- No Markdown fences.

Output ONLY:

BEGIN_IMPLEMENTATION_MD
<complete IMPLEMENTATION.md, starting with a project step heading and containing exactly one single-line record:
AUTOCYCLE_PLAN: {"objective":"stable objective label","finding_key":"stable underlying problem","kind":"work|administrative|verification","baseline":"concrete starting evidence","success":"observable result satisfying the original objective","verification":"specific read-only check for the following opening Review"}
Use actual values, not placeholders. The controller stamps the authoritative step and work IDs. Include bounded tasks and acceptance criteria below this record.>
END_IMPLEMENTATION_MD
PROMPT_EOF
    PROMPT=${PROMPT%$'\n'}

    set +e
    adjudication run "${AUTOCYCLE_PROVIDER_TIMEOUT:-900}" codex exec --sandbox read-only --output-last-message "$ANSWER" "$PROMPT" \
        >"$PLAN_LOG" 2>&1
    EXIT_CODE=$?
    set -e

    if [[ "$EXIT_CODE" -ne 0 ]]; then
        tail -n 15 "$PLAN_LOG"
        fail "Codex planning. Log: $PLAN_LOG"
    fi

    if grep -q '^PLAN_STATUS:' "$ANSWER"; then
        [[ "$(grep -c '^PLAN_STATUS:' "$ANSWER")" == 1 ]] && grep -qx 'PLAN_STATUS: BLOCKED' "$ANSWER" \
            || fail "malformed planning status."
        [[ "$(grep -c '^BLOCKER: .\+' "$ANSWER" || true)" == 1 ]] || fail "planning blocker lacks reason."
        ! grep -Eq '^(BEGIN_IMPLEMENTATION_MD|END_IMPLEMENTATION_MD)$' "$ANSWER" || fail "mixed planning blocker and implementation block."
        adjudication candidate planning "$ANSWER" "${AUTOCYCLE_INPUT_BATCH:-}" || fail "cannot preserve planning blocker."
        live_finish "↪" "Blocker candidate → Review"
        exit 42
    fi

    # Parse only the final answer, with exactly one unambiguous marker pair.
    [[ "$(grep -c '^BEGIN_IMPLEMENTATION_MD$' "$ANSWER" || true)" == 1 && \
       "$(grep -c '^END_IMPLEMENTATION_MD$' "$ANSWER" || true)" == 1 ]] || fail "ambiguous planning markers."

    BEGIN_LINE=$(
        grep -n '^BEGIN_IMPLEMENTATION_MD$' "$ANSWER" \
            | tail -n 1 \
            | cut -d: -f1 \
            || true
    )

    END_LINE=$(
        grep -n '^END_IMPLEMENTATION_MD$' "$ANSWER" \
            | tail -n 1 \
            | cut -d: -f1 \
            || true
    )

    [[ -n "$BEGIN_LINE" ]] \
        || fail "planner returned no IMPLEMENTATION.md block."

    [[ -n "$END_LINE" ]] \
        || fail "planner returned no closing marker."

    (( BEGIN_LINE < END_LINE )) \
        || fail "planner returned malformed markers."

    sed -n "$((BEGIN_LINE + 1)),$((END_LINE - 1))p" \
        "$ANSWER" > "$PLAN_FILE"

    [[ -s "$PLAN_FILE" ]] \
        || fail "planner returned an empty IMPLEMENTATION.md."

    FIRST_LINE=$(head -n 1 "$PLAN_FILE")

    [[ "$FIRST_LINE" == \#* ]] \
        || fail "generated IMPLEMENTATION.md has no heading."
    progress prepare "$PLAN_FILE" || fail "invalid plan progress contract."
}

# ============================================================
# Push plan via isolated worktree
# ============================================================

push_plan() {
    local REMOTE_NOW
    local WORKTREE
    local CHANGES
    local CHANGED_PATHS

    if [[ "$BRANCH" == "main" || "$BRANCH" == "master" ]]; then
        fail "refusing to push an automated plan directly to $BRANCH."
    fi

    git fetch --prune origin >/dev/null 2>&1 \
        || fail "could not refresh origin."

    REMOTE_NOW=$(git rev-parse "origin/$BRANCH")

    [[ "$REMOTE_NOW" == "$SHA" ]] \
        || fail "GitHub changed during review/planning."

    WORKTREE=$(mktemp -d "${TMPDIR:-/tmp}/autocycle-plan.XXXXXX")

    cleanup_worktree() {
        git -C "$ROOT" worktree remove --force "$WORKTREE" \
            >/dev/null 2>&1 || true
        rm -rf "$WORKTREE" >/dev/null 2>&1 || true
    }

    trap 'live_stop_timer; cleanup_worktree' EXIT

    git worktree add --detach "$WORKTREE" "$SHA" \
        >/dev/null 2>&1 \
        || fail "could not create planning worktree."

    cp "$PLAN_FILE" "$WORKTREE/IMPLEMENTATION.md"

    CHANGES=$(git -C "$WORKTREE" status --porcelain)

    if [[ -z "$CHANGES" ]]; then
        printf 'PLAN_STATUS: BLOCKED\nBLOCKER: generated plan is identical; no authorized progress was planned.\n' > "$PLAN_FILE.blocker"
        adjudication candidate planning "$PLAN_FILE.blocker" "${AUTOCYCLE_INPUT_BATCH:-}" || fail "cannot preserve planning dead end."
        live_finish "↪" "Unchanged plan → Review"
        exit 42
    fi

    CHANGED_PATHS=$(
        git -C "$WORKTREE" status --porcelain \
            | sed 's/^...//' \
            | sort -u
    )

    if [[ "$CHANGED_PATHS" != "IMPLEMENTATION.md" ]]; then
        echo "$CHANGES"
        fail "planning changed files other than IMPLEMENTATION.md."
    fi

    git -C "$WORKTREE" add IMPLEMENTATION.md

    PLAN_TITLE=$(
        head -n 1 "$PLAN_FILE" \
            | sed -E 's/^#+[[:space:]]*//'
    )

    [[ -n "$PLAN_TITLE" ]] || PLAN_TITLE="next implementation"

    local INPUT_COMMIT_NOTE=""
    if [[ -n "${AUTOCYCLE_INPUT_KEY:-}" ]]; then
        INPUT_COMMIT_NOTE=$(printf '\n\nAutocycle-Input-Batch: %s' "$AUTOCYCLE_INPUT_KEY")
    fi
    git -C "$WORKTREE" commit \
        -m "Plan: $PLAN_TITLE$INPUT_COMMIT_NOTE" \
        >/dev/null 2>&1 \
        || fail "could not commit planning change."

    PLAN_SHA=$(git -C "$WORKTREE" rev-parse HEAD)
    PLAN_SHORT_SHA=$(git -C "$WORKTREE" rev-parse --short HEAD)

    git fetch --prune origin >/dev/null 2>&1 \
        || fail "could not perform final remote check."

    REMOTE_NOW=$(git rev-parse "origin/$BRANCH")

    [[ "$REMOTE_NOW" == "$SHA" ]] \
        || fail "GitHub changed before planning push."

    git -C "$WORKTREE" push origin \
        "HEAD:refs/heads/$BRANCH" \
        >/dev/null 2>&1 \
        || fail "could not push planning commit."

    git fetch origin "$BRANCH" >/dev/null 2>&1

    [[ "$(git rev-parse "origin/$BRANCH")" == "$PLAN_SHA" ]] \
        || fail "planning push could not be verified."

    if [[ -n "${AUTOCYCLE_INPUT_KEY:-}" ]]; then
        python3 "$QUEUE_HELPER" --dir "$LOG_DIR" published "$AUTOCYCLE_INPUT_KEY" "$PLAN_SHA" \
            || fail "published plan could not be bound to human input."
    fi

    rm -f "$CACHE_FILE"

    cleanup_worktree
    trap live_stop_timer EXIT

    live_done "Planned: $PLAN_TITLE"
}

