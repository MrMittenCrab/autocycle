        fi

        if [[ "$EXIT_CODE" -eq 75 ]]; then
            node "$(dirname "$ADJUDICATOR")/stage_display.js" "$AUTOCYCLE_DISPLAY_STATE" Implement network-start
            node "$(dirname "$ADJUDICATOR")/stage_display.js" "$AUTOCYCLE_DISPLAY_STATE" Implement network-end "✗" "retry exhausted"
        fi
        node "$(dirname "$ADJUDICATOR")/stage_display.js" "$AUTOCYCLE_DISPLAY_STATE" Implement finish "–"
        echo "    – provider/network retry limit exhausted after 3 attempts; partial work saved. Run autocycle --resume when connectivity returns."
        echo "Log: $CURSOR_LOG"
        exit 76
    fi

    if [[ "$EXIT_CODE" -eq 42 ]]; then
        adjudication candidate implementation "$CURSOR_LOG" "${AUTOCYCLE_INPUT_BATCH:-}" || fail "cannot preserve blocker evidence."
        printf 'HEAD: %s\nBRANCH: %s\nLOG: %s\nOUTCOME: BLOCKED_CANDIDATE\n' \
            "$BEFORE_SHA" "$(git branch --show-current)" "$CURSOR_LOG" > "$LOG_DIR/latest-implementation.tmp.$$"
        mv "$LOG_DIR/latest-implementation.tmp.$$" "$LOG_DIR/latest-implementation"
        exit 42
    fi
    if [[ "$EXIT_CODE" -ne 0 ]]; then
        fail "implementation. Log: $CURSOR_LOG"
    fi

    [[ "$(git rev-parse HEAD)" == "$BEFORE_SHA" ]] \
        || fail "implementation changed Git HEAD."

    if ! (assert_owned_docs "$BEFORE_SHA"); then
        adjudication candidate checkpoint "$CURSOR_LOG" "${AUTOCYCLE_INPUT_BATCH:-}" || fail "cannot preserve ownership evidence."
        exit 42
    fi
    adjudication implementation-result || fail "cannot freeze implementation work for checkpoint."

    # Save a pointer to this successful run's evidence, including no-change runs.
    local EVIDENCE_TMP="$LOG_DIR/latest-implementation.tmp.$$"
    printf 'HEAD: %s\nBRANCH: %s\nLOG: %s\n' \
        "$BEFORE_SHA" "$(git branch --show-current)" "$CURSOR_LOG" > "$EVIDENCE_TMP"
    mv "$EVIDENCE_TMP" "$LOG_DIR/latest-implementation"
    if [[ "${AUTOCYCLE_CONTROLLER_REVIEW:-}" != 1 ]]; then
        node "$(dirname "$ADJUDICATOR")/stage_display.js" "$AUTOCYCLE_DISPLAY_STATE" Implement finish "✓"
    fi
}

