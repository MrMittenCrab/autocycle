const { spawn, execFileSync } = require("node:child_process");
const readline = require("node:readline");
const fs = require("node:fs");
const { ImplementationResponse, transportError } = require(process.argv[4]);
const adjudicator = require("node:path").join(require("node:path").dirname(process.argv[4]), "adjudication.py");
const observerEvidence = execFileSync("python3", [require("node:path").join(require("node:path").dirname(adjudicator), "native_office.py"), "review-evidence"], {encoding:"utf8"});

const root = process.argv[2];
const logFile = process.argv[3];

process.chdir(root);

function git(...args) {
  return execFileSync("git", args, {
    cwd: root,
    encoding: "utf8"
  }).trim();
}

const beforeSha = git("rev-parse", "HEAD");
const beforeBranch = git("branch", "--show-current");

if (
  git("status", "--porcelain") &&
  process.env.AUTOCYCLE_ALLOW_DIRTY !== "1"
) {
  console.error("Implementation failed: working tree is not clean.");
  process.exit(1);
}

const log = fs.createWriteStream(logFile, { flags: "a" });
const { StageDisplay } = require(require('node:path').join(require('node:path').dirname(process.argv[4]), 'stage_display.js'));
const display = new StageDisplay(process.env.AUTOCYCLE_DISPLAY_STATE, 'Implement');

let nextId = 1;
const pending = new Map();

const todos = new Map();
let todoOrder = [];

let finished = false;
let shuttingDown = false;
let retryableStall = false;
const response = new ImplementationResponse();

function redraw(forceFinal = false) {
  display.tasks(todoOrder.map(id => todos.get(id)).filter(Boolean));
  if (forceFinal) display.clearTimer();
  if (forceFinal && finished) display.tick();
}

function mergeTodos(incoming, merge) {
  if (!merge) {
    todos.clear();
    todoOrder = [];
  }

  for (const todo of incoming || []) {
    if (!todos.has(todo.id)) {
      todoOrder.push(todo.id);
    }

    const previous = todos.get(todo.id) || {};
    todos.set(todo.id, { ...previous, ...todo });
  }

  redraw();
}

const agent = spawn("agent", ["acp"], {
  cwd: root,
  detached: true,
  stdio: ["pipe", "pipe", "pipe"]
});

let agentClosed = false;
agent.on("close", () => { agentClosed = true; });
// The provider has its own process group so transport recovery can stop tools.
// Forward controller termination too; a forced stop creates no resume receipt.
for (const [signal, code] of [["SIGTERM", 143], ["SIGINT", 130]]) {
  process.once(signal, () => {
    shuttingDown = true;
    try { process.kill(-agent.pid, "SIGTERM"); } catch {}
    log.end(() => process.exit(code));
  });
}

agent.stderr.on("data", chunk => {
  log.write(`[stderr] ${chunk}`);
});

function send(method, params) {
  const id = nextId++;

  agent.stdin.write(
    JSON.stringify({
      jsonrpc: "2.0",
      id,
      method,
      params
    }) + "\n"
  );

  return new Promise((resolve, reject) => {
    pending.set(id, { resolve, reject });
  });
}

function respond(id, result) {
  agent.stdin.write(
    JSON.stringify({
      jsonrpc: "2.0",
      id,
      result
    }) + "\n"
  );
}

const rl = readline.createInterface({
  input: agent.stdout
});

rl.on("line", line => {
  log.write(line + "\n");

  let msg;

  try {
    msg = JSON.parse(line);
  } catch {
    return;
  }

  const updateText =
    msg?.params?.update?.content?.text;

  response.observe(msg);

  if (
    msg.method === "session/update" &&
    typeof updateText === "string" &&
    /^(?:Error: )?Connection stalled(?:[.:]|$)/.test(updateText)
  ) {
    retryableStall = true;
  }

  if (
    msg.id !== undefined &&
    (msg.result !== undefined || msg.error !== undefined)
  ) {
    const waiter = pending.get(msg.id);

    if (!waiter) {
      return;
    }

    pending.delete(msg.id);

    if (msg.error !== undefined) {
      waiter.reject(msg.error);
    } else {
      waiter.resolve(msg.result);
    }

    return;
  }

  if (msg.method === "session/request_permission") {
    const options = msg.params?.options || [];

    const allow =
      options.find(option => option.kind === "allow_always") ||
      options.find(option => option.kind === "allow_once") ||
      options.find(option =>
        /allow|approve/i.test(
          `${option.name || ""} ${option.label || ""} ${option.optionId || ""}`
        )
      ) ||
      options[0];

    if (!allow) {
      respond(msg.id, {
        outcome: {
          outcome: "cancelled"
        }
      });
      return;
    }

    respond(msg.id, {
      outcome: {
        outcome: "selected",
        optionId: allow.optionId
      }
    });
    return;
  }

  if (msg.method === "cursor/create_plan") {
    mergeTodos(msg.params?.todos || [], false);

    respond(msg.id, {
      outcome: {
        outcome: "accepted"
      }
    });
    return;
  }

  if (msg.method === "cursor/ask_question") {
    respond(msg.id, {
      outcome: {
        outcome: "skipped",
        reason:
          "Autonomous implementation. Follow IMPLEMENTATION.md; stop if external input is required."
      }
    });
    return;
  }

  if (msg.method === "cursor/update_todos") {
    mergeTodos(
      msg.params?.todos || [],
      Boolean(msg.params?.merge)
    );
  }
});

agent.on("exit", code => {
  if (shuttingDown) {
    return;
  }

  for (const { reject } of pending.values()) {
    reject(
      new Error(`Cursor ACP exited unexpectedly (${code}).`)
    );
  }

  pending.clear();
});

