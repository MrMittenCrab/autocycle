#!/bin/bash
set -euo pipefail
if ! declare -F autocycle_git >/dev/null; then autocycle_git() { command git "$@"; }; fi
ADJUDICATOR="$HOME/.autocycle/adjudication.py"
adjudication() { python3 "$ADJUDICATOR" "$@"; }
progress() { python3 "$(dirname "$ADJUDICATOR")/progress.py" "$@"; }

usage() {
    echo "Usage:"
    echo "  autocycle <cycles>"
    echo "  autocycle <cycles> --dry-run"
    echo "  autocycle --review-only"
    echo "  autocycle --plan-only"
    echo "  autocycle --implement-only"
    exit 1
}

LIVE_TIMER_PID=""
LIVE_TIMER_LABEL=""

live_stop_timer() {
    if [[ -n "${LIVE_TIMER_PID:-}" ]]; then
        local TRY
        for ((TRY=0; TRY<50; TRY++)); do
            kill -0 "$LIVE_TIMER_PID" 2>/dev/null || break
            [[ ! -f "${AUTOCYCLE_DISPLAY_STATE:-}.renderer-$LIVE_TIMER_PID" ]] || break
            sleep 0.02
        done
        kill "$LIVE_TIMER_PID" >/dev/null 2>&1 || true
        wait "$LIVE_TIMER_PID" >/dev/null 2>&1 || true
        LIVE_TIMER_PID=""
    fi
} 2>/dev/null

trap live_stop_timer EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

live_start() {
    local LABEL="$1"
    live_stop_timer
    LIVE_TIMER_LABEL="$LABEL"
    if [[ -z "${AUTOCYCLE_DISPLAY_STATE:-}" ]]; then
        AUTOCYCLE_DISPLAY_STATE=$(mktemp "$LOG_DIR/stage-display.XXXXXX")
        export AUTOCYCLE_DISPLAY_STATE
    fi
    node "$(dirname "$ADJUDICATOR")/stage_display.js" "$AUTOCYCLE_DISPLAY_STATE" "$LABEL" clock >/dev/null
    if [[ -t 1 ]]; then
        node "$(dirname "$ADJUDICATOR")/stage_display.js" "$AUTOCYCLE_DISPLAY_STATE" "$LABEL" live &
        LIVE_TIMER_PID=$!
    fi
}

live_finish() {
    local SYMBOL="$1"
    local SUMMARY="${2:-}"
    live_stop_timer
    local ACTION=finish
    [[ "${AUTOCYCLE_CONTROLLER_REVIEW:-}" != 1 ]] || ACTION=outcome
    node "$(dirname "$ADJUDICATOR")/stage_display.js" "$AUTOCYCLE_DISPLAY_STATE" "$LIVE_TIMER_LABEL" "$ACTION" "$SYMBOL" "$SUMMARY"
    LIVE_TIMER_LABEL=""
}

live_done() {
    live_finish "✓" "${1:-}"
}

provider_failure() {
    if [[ "${AUTOCYCLE_CONTROLLER_REVIEW:-}" == 1 ]] &&
       node "$(dirname "$ADJUDICATOR")/implementation_response.js" --transport "$2"; then
        live_stop_timer
        printf '%s\n' "$1" > "$AUTOCYCLE_DISPLAY_STATE.failure"
        exit 74
    fi
    fail "$1"
}

live_fail() {
    live_finish "✗"
}

fail() {
    if [[ "${LIVE_TIMER_LABEL:-}" == Review || "${LIVE_TIMER_LABEL:-}" == Plan ]]; then
        live_finish "✗" "$1"
        exit 1
    fi
    if [[ -n "${LIVE_TIMER_PID:-}" ]]; then
        live_fail
    fi

    echo
    echo "FAILED: $1"
    exit 1
}

# ============================================================
# Arguments
# ============================================================

MODE="--run"
MAX_CYCLES=1

if [[ $# -eq 1 ]]; then
    if [[ "$1" =~ ^[1-9][0-9]*$ ]]; then
        MAX_CYCLES="$1"
    else
        MODE="$1"
    fi
elif [[ $# -eq 2 ]]; then
    MAX_CYCLES="$1"
    MODE="$2"

    if ! [[ "$MAX_CYCLES" =~ ^[1-9][0-9]*$ ]]; then
        usage
    fi
elif [[ $# -gt 2 ]]; then
    usage
fi

case "$MODE" in
    --run|--dry-run|--review-only|--plan-only|--implement-only)
        ;;
    *)
        usage
        ;;
esac

# ============================================================
# Repository
# ============================================================

if [[ "$MODE" == "--run" ]]; then
    exec "$HOME/bin/autocycle" "$MAX_CYCLES"
fi

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
    fail "not inside a Git repository."
}

cd "$ROOT"

command -v git >/dev/null 2>&1 || fail "git not found."

needs_codex=0
needs_cursor=0

case "$MODE" in
    --run)
        needs_codex=1
        needs_cursor=1
        ;;
    --review-only|--plan-only)
        needs_codex=1
        ;;
    --implement-only)
        needs_cursor=1
        ;;
esac

if [[ "$needs_codex" -eq 1 ]]; then
    command -v codex >/dev/null 2>&1 || fail "codex not found."

    AUTH=$(codex login status 2>&1 || true)

    if [[ "$AUTH" != *"Logged in using ChatGPT"* ]]; then
        fail "Codex is not authenticated using ChatGPT."
    fi
fi

if [[ "$needs_cursor" -eq 1 ]]; then
    command -v agent >/dev/null 2>&1 || fail "Cursor agent not found."
    command -v node >/dev/null 2>&1 || fail "Node.js not found."
fi



# ============================================================
# State
# ============================================================

BRANCH=""
SHA=""
SHORT_SHA=""
REMOTE_SHA=""

refresh_state() {
    if [[ "$MODE" == "--review-only" && "${AUTOCYCLE_LOCAL_REVIEW:-0}" == 1 ]]; then
        BRANCH=$(git branch --show-current)
        [[ -n "$BRANCH" ]] || fail "detached HEAD; local evidence preserved."
        SHA=$(git rev-parse HEAD)
        SHORT_SHA=$(git rev-parse --short HEAD)
        return
    fi
    BRANCH=$(git branch --show-current)

    [[ -n "$BRANCH" ]] || fail "detached HEAD."

    if [[ -n "$(git status --porcelain)" ]]; then
        if [[ "$MODE" == "--implement-only" \
           && "${AUTOCYCLE_ALLOW_DIRTY:-0}" == "1" ]]; then
            :
        else
            echo "Working tree:"
            git status --short
            fail "working tree is not clean."
        fi
    fi

    autocycle_git fetch --prune origin >/dev/null 2>&1 \
        || fail "could not fetch origin."

    SHA=$(git rev-parse HEAD)
    SHORT_SHA=$(git rev-parse --short HEAD)

    if ! git show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
        fail "origin/$BRANCH does not exist."
    fi

    REMOTE_SHA=$(git rev-parse "origin/$BRANCH")

    if [[ "$REMOTE_SHA" != "$SHA" ]]; then
        echo "Local:  $SHA"
        echo "Remote: $REMOTE_SHA"
        fail "local branch and GitHub are not synchronized."
    fi
}

refresh_state

